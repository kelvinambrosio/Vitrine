# Copie este arquivo para .env.local e preencha. NUNCA publique o .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor. Nunca coloque NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do site (em produção use https://seudominio.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=contato@seudominio.com.br

# Mercado Pago (aplicação criada em Suas integrações)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave secreta da assinatura de webhooks (Webhooks > Configurar notificações)
MP_WEBHOOK_SECRET=

# E-mails de aviso de pedido (opcional; sem isso os avisos aparecem só dentro do site). Conta grátis em resend.com
RESEND_API_KEY=
EMAIL_FROM=Minha Vitrine <avisos@seudominio.com.br>

# Senha qualquer e longa (ex.: 32 letras/números aleatórios). Protege a limpeza diária de pedidos.
CRON_SECRET=

# Comissão padrão (0.05 = 5%). O admin pode alterar no painel /admin.
COMMISSION_RATE=0.05
